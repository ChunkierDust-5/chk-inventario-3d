{
  "name": "backend-inventario-3d",
  "version": "1.0.0",
  "description": "Current Holdings Keeper - Sistema de Gestión de Insumos e Impresiones",
  "main": "main.js",
  "scripts": {
    "start": "node index.js",
    "electron": "electron .",
    "build:win": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.chk.app",
    "productName": "CHK",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}